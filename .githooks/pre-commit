#!/bin/bash
# Blocks commits that appear to contain secrets. Enable with:
#   git config core.hooksPath .githooks
set -euo pipefail
pattern='(sk-ant-[A-Za-z0-9_-]{10,}|sk-[A-Za-z0-9]{32,}|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{30,}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'
if git diff --cached -U0 --no-color | grep -E '^\+' | grep -Ev '^\+\+\+' | grep -En "$pattern" >&2; then
  echo "pre-commit: possible secret in staged changes. Commit aborted." >&2
  exit 1
fi
